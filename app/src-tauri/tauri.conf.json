{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lanyell",
  "version": "0.2.0",
  "identifier": "com.boomsi.lanyell",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run build:ui",
    "beforeDevCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "title": "lanyell",
        "width": 380,
        "height": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "externalBin": ["binaries/lanyell-server"],
    "resources": {
      "../resources/public": "public"
    }
  }
}
