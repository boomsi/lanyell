  "license": "MIT",
  "author": "boomsi",
  "homepage": "https://github.com/boomsi/lanyell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boomsi/lanyell.git"
  },
  "bugs": {
    "url": "https://github.com/boomsi/lanyell/issues"
  },
  "bin": {
    "lanyell": "server.js"
  },
  "main": "server.js",
  "files": [
    "server.js",
    "lib/",
    "public/"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
